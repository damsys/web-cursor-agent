# systemd user unit のテンプレート。
# リポジトリルートのプレースホルダは make -f Makefile.agent install-service が絶対パスに展開する。
[Unit]
Description=web-cursor-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/bin/web-cursor-agent serve --config @REPO_ROOT@/config.yaml
Restart=on-failure
RestartSec=5
# agent / gh などユーザー領域の CLI を解決する。
Environment=PATH=%h/.local/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
